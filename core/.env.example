# Copy to .env and fill in. .env is gitignored; this file is not.

# Neon: use the POOLED endpoint (host contains "-pooler") for app queries.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon: use the DIRECT endpoint (no "-pooler") for migrations.
# Prisma Migrate needs advisory locks that PgBouncer transaction mode drops.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

PORT=8000
HOST=0.0.0.0

# ANTHROPIC_API_KEY=sk-ant-...
