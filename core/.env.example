# Copy to .env and fill in. .env is gitignored; this file is not.
# Everything marked REQUIRED must be set. Everything else shows its default.

# --- Database (REQUIRED) -----------------------------------------------------
# Postgres with the pgvector extension. Built against Neon's free tier.
#
# Neon serves two endpoints for the same database and they are not interchangeable:
# the POOLED one (host contains "-pooler") for app queries, the DIRECT one for
# migrations. Prisma Migrate takes advisory locks that PgBouncer's transaction mode
# drops, so migrations over the pooler hang or fail.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Model (REQUIRED) --------------------------------------------------------
# https://aistudio.google.com/apikey
# WARNING: the free tier allows 20 requests per DAY per model. One investigation costs
# roughly 6-12, so you get one or two runs a day before everything 429s. Enable billing,
# or change MODEL in src/agent/run.ts — the quota is per model, so another has its own.
GEMINI_API_KEY="..."

# Model for the agent loop. Quota is per model, so switching is the cheapest way out of a
# daily rate limit. Reranking follows this unless GEMINI_RERANK_MODEL overrides it.
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_RERANK_MODEL="gemini-3.8-flash"

# --- API tokens (REQUIRED) ---------------------------------------------------
# Both fail CLOSED with 503 if unset — an ingestion endpoint that accepts everything
# because a variable is missing is the worse default.
#
# Guards the alert webhooks. Must match the Bearer credentials in
# observability/alertmanager/alertmanager.yml.
INGEST_TOKEN="local-dev-token"

# Guards the read + approval API. Separate from INGEST_TOKEN so the dashboard and the
# alerting system rotate independently; falls back to INGEST_TOKEN if unset.
API_TOKEN="local-dev-token"

# --- The target system -------------------------------------------------------
# The repo Healix reads, patches, and tests. Defaults to ../demo-service.
# TARGET_REPO="/abs/path/to/your-repo"

# Retrieval index name. MUST match what you passed to `npm run index`.
# INDEXED_REPO="demo-service"

# What run_tests executes inside the sandbox.
# TEST_COMMAND="npm test"

# --- Sandbox -----------------------------------------------------------------
# SANDBOX_URL="http://localhost:4000"

# The path the SANDBOX sees for the target repo — not necessarily the path Healix sees.
# Running natively the two coincide (the default). Running via docker compose the repo
# is bind-mounted elsewhere and this MUST be set, or every test run fails with
# "could not start command".
# SANDBOX_REPO_PATH="/workspace/demo-service"

# --- Pull requests (optional) ------------------------------------------------
# Without these the agent still investigates and proposes patches; only
# approval-opens-a-PR is disabled.
#
# Use a FINE-GRAINED token scoped to the single target repository, with
# Contents: read/write and Pull requests: read/write. Least privilege matters here —
# this credential is handed to code acting on model output.
# GITHUB_TOKEN="github_pat_..."
# GITHUB_REPO="owner/repo"
# GITHUB_BASE_BRANCH="main"

# --- Guardrails --------------------------------------------------------------
# Checked before each model call, so a breach costs nothing.
# AGENT_MAX_PASSES=12
# AGENT_MAX_STEPS=40
# AGENT_TOKEN_BUDGET=200000
# AGENT_REPEAT_LIMIT=3

# --- Supervisor --------------------------------------------------------------
# Resumes runs orphaned by a dead process. STALE_MS must comfortably exceed your slowest
# single step including retry backoff — a supervisor that resumes a run which is merely
# thinking puts two processes on one conversation.
# SUPERVISOR_STALE_MS=600000
# SUPERVISOR_INTERVAL_MS=300000
# SUPERVISOR_MAX_ATTEMPTS=3

# --- Server ------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Unused; kept for a possible Claude eval run later.
# ANTHROPIC_API_KEY=sk-ant-...
